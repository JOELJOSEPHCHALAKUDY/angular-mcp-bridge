{
  "name": "angular-mcp-bridge-workspace",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/angular",
    "packages/server",
    "packages/cli",
    "packages/testing"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:packages": "npm run build -w @angular-mcp-bridge/contracts && npm run build -w @angular-mcp-bridge/server && npm run build -w @angular-mcp-bridge/testing && ng build bridge",
    "build:web": "node packages/cli/bin/bridge.mjs build",
    "build": "npm run build:packages && npm run build:web",
    "dev": "npm run build:packages && node packages/cli/bin/bridge.mjs dev",
    "start": "node packages/cli/bin/bridge.mjs start",
    "check": "tsc --noEmit -p tsconfig.server.json && ng build bridge && ng build demo && ng build lab && ng build workbench",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scaffold": "node packages/cli/bin/bridge.mjs create",
    "create": "node tooling/create-app.mjs",
    "doctor": "node packages/cli/bin/bridge.mjs doctor",
    "docs:check": "node tooling/check-docs.mjs",
    "benchmark": "node tooling/benchmark.mjs",
    "pack:all": "node tooling/sync-template.mjs && node tooling/pack.mjs",
    "preview": "tsx tooling/preview.ts",
    "add-view": "node packages/cli/bin/bridge.mjs add-view",
    "tunnel": "node packages/cli/bin/bridge.mjs tunnel",
    "deploy": "node packages/cli/bin/bridge.mjs deploy"
  },
  "dependencies": {
    "@angular-mcp-bridge/angular": "0.1.4",
    "@angular-mcp-bridge/contracts": "0.1.4",
    "@angular-mcp-bridge/server": "0.1.4",
    "@angular/aria": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "22.2.2",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "ai": "7.0.137",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.1",
    "ng-packagr": "~22.2.0",
    "node": "24.15.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
